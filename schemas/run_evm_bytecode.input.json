{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-docs.feelyourprotocol.org/schemas/run_evm_bytecode.input.json",
  "title": "run_evm_bytecode input",
  "type": "object",
  "properties": {
    "bytecode": {
      "type": "string",
      "description": "Hex-encoded EVM bytecode (0x prefix optional). Max 24576 bytes. Required unless messageCall is set."
    },
    "messageCall": {
      "type": "object",
      "description": "Value-bearing message call — alternative to bytecode for plain ETH moves and receipt logs.",
      "properties": {
        "caller": { "type": "string", "description": "Hex sender address" },
        "to": { "type": "string", "description": "Hex target address" },
        "value": { "type": "string", "description": "Value in wei (decimal string). Default 0." },
        "data": { "type": "string", "description": "Optional calldata hex" },
        "code": { "type": "string", "description": "Optional runtime bytecode installed at to before the call" }
      },
      "required": ["caller", "to"],
      "additionalProperties": false
    },
    "fork": {
      "type": "object",
      "properties": {
        "baseHardfork": { "type": "string" },
        "eips": {
          "type": "array",
          "items": { "type": "integer" }
        }
      },
      "required": ["baseHardfork"]
    },
    "gasLimit": {
      "type": "string",
      "description": "Execution gas limit as decimal string. Default 1000000. Max 30000000."
    },
    "trace": {
      "type": "boolean",
      "description": "Include stack-only opcode trace when true (max 10000 steps)."
    }
  },
  "oneOf": [{ "required": ["bytecode"] }, { "required": ["messageCall"] }],
  "additionalProperties": false
}
